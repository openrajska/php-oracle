{
    "name": "openrajska/php-oracle",
    "description": "A typed API for Oracle Database in PHP",
    "type": "library",
    "license": ["MIT", "Apache-2.0"],
    "require": {
        "php": "~8.4.0",
        "ext-oracledb": "^0.1"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "Rajska\\Oracle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rajska\\Oracle\\Bench\\": "bench/src/",
            "Rajska\\Oracle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "format": "pint",
        "format:check": "pint --test",
        "refactor": "rector process",
        "refactor:check": "rector process --dry-run",
        "test": "phpunit"
    }
}
