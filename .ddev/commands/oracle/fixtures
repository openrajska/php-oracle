#!/usr/bin/env bash

## Description: Instala (ou reinstala) o schema de fixtures de fixtures/sql no usuário de app, com os grants das suítes, e sobe o DRCP e os listeners TCPS dos testes
## Usage: fixtures
## Example: "ddev fixtures"

set -euo pipefail
cd /fixtures/sql
sqlplus -s -l / as sysdba @drcp.sql
# Montado a partir do próximo `ddev restart` (docker-compose.oracle.yaml).
if [ -d /fixtures/tls ]; then
    bash /fixtures/tls/listeners.sh
fi
sqlplus -s -l "sys/${ORACLE_PASSWORD}@//localhost/FREEPDB1" as sysdba @grants.sql "${APP_USER}"
exec sqlplus -s -l "${APP_USER}/${APP_USER_PASSWORD}@//localhost/FREEPDB1" @install.sql
